# =============================================================
#  Naukri Auto Apply Bot Credentials & Details (Template)
# =============================================================

# Your Naukri.com login credentials
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password

# Minimum salary filter in LPA (jobs below this are skipped; undisclosed/not disclosed jobs are allowed)
MIN_SALARY_LPA=12

# Target search keywords (prioritizing AI Engineer & Data Scientist roles first!)
SEARCH_KEYWORDS=AI Engineer, Data Scientist, Gen AI Engineer, Machine Learning Engineer, ML Engineer, Data Engineer, Python Developer, Backend Developer, Full Stack Developer, Software Engineer, Software Developer, Data Analyst

# Details used by the bot to automatically answer recruiter screening questions
TOTAL_EXPERIENCE=1       # Total years of experience (numeric, e.g. 1, 2, 5)
NOTICE_PERIOD=30         # Notice period in days (e.g., 15, 30, 60, 90)
CURRENT_CTC=11           # Current CTC in LPA (e.g., 11 for 11 LPA)
EXPECTED_CTC=15          # Expected CTC in LPA (e.g., 15 for 15 LPA)

# Max applications per role/keyword before moving to the next role
MAX_APPLIES_PER_KEYWORD=50

# Timeout in seconds to apply & answer questions for a single job before auto-skipping forever
APPLY_TIMEOUT_SECONDS=10

